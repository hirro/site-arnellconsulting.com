---
/** Small inline stroke icon set. Inherits color via currentColor. */
interface Props {
  name:
    | 'code'
    | 'cloud'
    | 'shield'
    | 'chart'
    | 'calendar'
    | 'compass'
    | 'ledger'
    | 'arrow-right'
    | 'arrow-up-right'
    | 'mail'
    | 'linkedin';
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 24, strokeWidth = 1.7, class: className } = Astro.props;
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'code' && (<><path d="m8 7-5 5 5 5" /><path d="m16 7 5 5-5 5" /><path d="m14 4-4 16" /></>)}
  {name === 'cloud' && <path d="M17.5 19H8a5 5 0 1 1 1.2-9.86A6 6 0 0 1 20.6 11.5 3.75 3.75 0 0 1 17.5 19Z" />}
  {name === 'shield' && (<><path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6l-8-3Z" /><path d="m9 12 2 2 4-4" /></>)}
  {name === 'chart' && (<><path d="M3 3v18h18" /><path d="m7 15 4-4 3 3 5-6" /></>)}
  {name === 'calendar' && (<><rect x="3" y="4" width="18" height="17" rx="2" /><path d="M3 9h18" /><path d="M8 2v4" /><path d="M16 2v4" /></>)}
  {name === 'compass' && (<><circle cx="12" cy="12" r="9" /><path d="m15.5 8.5-2 5-5 2 2-5 5-2Z" /></>)}
  {name === 'ledger' && (<><path d="M4 4h16v16H4z" /><path d="M4 10h16" /><path d="M10 10v10" /></>)}
  {name === 'arrow-right' && (<><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></>)}
  {name === 'arrow-up-right' && (<><path d="M7 17 17 7" /><path d="M8 7h9v9" /></>)}
  {name === 'mail' && (<><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></>)}
  {name === 'linkedin' && (<><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" /><rect width="4" height="12" x="2" y="9" /><circle cx="4" cy="4" r="2" /></>)}
</svg>
