---
import type { TeamMember } from '../data/team';
import Icon from './Icon.astro';

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
const initials = member.name.split(' ').map((n) => n[0]).join('');
---
<article class="member">
  <div class="member__photo-wrap">
    {member.image ? (
      <img
        src={member.image}
        alt={`Portrait of ${member.name}`}
        class="member__photo"
        width="240"
        height="300"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span class="member__initials" aria-hidden="true">{initials}</span>
    )}
  </div>
  <div class="member__body">
    <div class="member__heading">
      <p class="member__area">{member.area}</p>
      <h3 class="member__name">{member.name}</h3>
    </div>
    <p class="member__bio">{member.bio}</p>
    <p class="member__skills">
      <span class="visually-hidden">Expertise: </span>{member.expertise.join(' · ')}
    </p>
    <div class="member__links">
      <a href={`mailto:${member.email}`}>
        <Icon name="mail" size={18} strokeWidth={1.8} />Email
      </a>
      <a href={member.linkedIn} target="_blank" rel="noopener noreferrer">
        <Icon name="linkedin" size={18} strokeWidth={1.8} />LinkedIn
      </a>
    </div>
  </div>
</article>

<style>
  .member {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 32px;
    padding: 32px;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .member__photo-wrap {
    width: 240px;
    height: 300px;
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-dark);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .member__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .member__initials {
    font-family: var(--font-display);
    font-size: 64px;
    color: var(--color-dark-text);
  }

  .member__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  .member__heading {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .member__area {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .member__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 38px;
    line-height: 1.1;
    color: var(--color-text);
  }

  .member__bio {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--line-relaxed);
    color: var(--color-text-muted);
  }

  .member__skills {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text);
  }

  .member__links {
    display: flex;
    gap: 20px;
    margin-top: auto;
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .member__links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 1180px) {
    .member {
      grid-template-columns: 180px minmax(0, 1fr);
      gap: 24px;
      padding: 24px;
    }

    .member__photo-wrap {
      width: 180px;
      height: 225px;
    }
  }

  @media (max-width: 560px) {
    .member {
      grid-template-columns: minmax(0, 1fr);
    }

    .member__photo-wrap {
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 5;
      max-height: 360px;
    }

    .member__photo {
      object-position: 50% 20%;
    }
  }
</style>
