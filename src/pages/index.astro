---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TeamCard from '../components/TeamCard.astro';
import Icon from '../components/Icon.astro';
import { services } from '../data/services';
import { team } from '../data/team';

const facts = [
  { label: 'Founded', value: '2005', big: true },
  { label: 'Experience', value: '20+ yrs', big: true },
  { label: 'Senior consultants', value: String(team.length), big: true },
  { label: 'Based in', value: 'Värmdö, Stockholm', big: false },
];

const steps = [
  {
    n: 'i.',
    title: 'Understand the problem',
    text: 'We start with your situation, not a template — what needs to change, and why.',
  },
  {
    n: 'ii.',
    title: 'Apply the right expertise',
    text: 'A senior consultant does the work — technology, finance, or both together.',
  },
  {
    n: 'iii.',
    title: 'Deliver with clarity',
    text: 'Results you can run, read and build on — documented and handed over cleanly.',
  },
];
---
<Layout
  title="Arnell Consulting — Technology & Business Consulting"
  description="Arnell Consulting AB is a Stockholm-based boutique consultancy: software development, cloud and security, plus business controlling and financial analysis."
>

  <!-- Hero -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__main">
        <p class="eyebrow fade-up">Technology &amp; business consulting · Stockholm</p>
        <h1 class="heading-hero fade-up fade-up-delay-1">
          Clarity for your <em class="accent">systems</em> and your <em class="accent">numbers</em>.
        </h1>
        <p class="hero__lead fade-up fade-up-delay-2">
          Arnell Consulting is a boutique consultancy of two senior consultants — one in software, cloud and security, one in business controlling and financial analysis. No overhead, no complexity for its own sake.
        </p>
        <div class="hero__actions fade-up fade-up-delay-3">
          <a href="#contact" class="btn btn--primary">
            Start a conversation
            <Icon name="arrow-right" size={18} strokeWidth={1.8} />
          </a>
          <a href="#services" class="btn btn--outline">What we do</a>
        </div>
      </div>
      <aside class="facts fade-up fade-up-delay-4" aria-label="At a glance">
        <dl class="facts__list">
          {facts.map((f) => (
            <div class="facts__row">
              <dt>{f.label}</dt>
              <dd class={f.big ? 'facts__big' : 'facts__small'}>{f.value}</dd>
            </div>
          ))}
        </dl>
      </aside>
    </div>
  </section>

  <!-- Services -->
  <section class="services" id="services">
    <div class="container services__inner">
      <div class="services__head">
        <div class="services__title">
          <p class="eyebrow services__eyebrow">What we do</p>
          <h2 class="heading-display services__heading">Two disciplines, one team that speaks both.</h2>
        </div>
        <p class="services__lead">
          From building and securing software systems to financial steering and operational analysis — we cover the full spectrum.
        </p>
      </div>
      {services.map((service, i) => (
        <ServiceCard service={service} index={i} />
      ))}
    </div>
  </section>

  <!-- Approach -->
  <section class="section" id="approach">
    <div class="container approach">
      <div class="approach__title">
        <p class="eyebrow">Our approach</p>
        <h2 class="heading-1">Straightforward, by design.</h2>
      </div>
      <p class="approach__lead">
        Since 2005 we have worked closely with our clients to deliver solutions that are practical, well-crafted and lasting — pairing deep technical expertise with sharp business acumen.
      </p>
      <ol class="approach__steps">
        {steps.map((s) => (
          <li class="approach__step">
            <span class="approach__n" aria-hidden="true">{s.n}</span>
            <h3 class="heading-3">{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Team -->
  <section class="section team" id="team">
    <div class="container team__inner">
      <div class="team__head">
        <div class="team__title">
          <p class="eyebrow">The team</p>
          <h2 class="heading-1">The people behind the work.</h2>
        </div>
        <p class="text-lead team__lead">
          Two senior consultants with complementary expertise — one in technology, one in business.
        </p>
      </div>
      <div class="team__grid">
        {team.map((member) => (
          <TeamCard member={member} />
        ))}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="section" id="contact">
    <div class="container contact">
      <div class="contact__intro">
        <p class="eyebrow">Contact</p>
        <h2 class="heading-hero contact__heading">Let’s talk about <em class="accent">your</em> problem.</h2>
        <p class="text-lead">Write to the person closest to your question — we reply personally.</p>
      </div>
      <div class="contact__cards">
        {team.map((m, i) => (
          <a href={`mailto:${m.email}`} class={`contact__card ${i === 0 ? 'contact__card--dark' : ''}`}>
            <span class="contact__card-text">
              <span class="contact__card-label">
                {m.area === 'Technology' ? 'Technology & development' : 'Finance & controlling'}
              </span>
              <span class="contact__card-email">{m.email}</span>
            </span>
            <Icon name="arrow-up-right" size={24} strokeWidth={1.8} class="contact__card-icon" />
          </a>
        ))}
        <address class="contact__address">
          Arnell Consulting AB · Winges väg 6 · 139 60 Värmdö · Sweden
        </address>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Hero */
  .hero {
    padding-block: clamp(4.5rem, 9vw, 8rem) clamp(4rem, 8vw, 7.5rem);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    row-gap: 56px;
    align-items: end;
  }

  .hero__main {
    grid-column: span 8;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .hero__lead {
    margin: 0;
    max-width: 600px;
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .hero__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .facts {
    grid-column: 10 / span 3;
  }

  .facts__list {
    margin: 0;
    border-top: 1px solid var(--color-text);
  }

  .facts__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .facts__row:last-child {
    border-bottom: none;
  }

  .facts__row dt {
    font-size: 14px;
    color: var(--color-text-soft);
  }

  .facts__row dd {
    margin: 0;
    text-align: right;
  }

  .facts__big {
    font-family: var(--font-display);
    font-size: 36px;
    line-height: 1;
  }

  .facts__small {
    font-size: var(--text-base);
    font-weight: 500;
  }

  /* Services */
  .services {
    background: var(--color-dark);
    color: var(--color-dark-text);
    padding-block: var(--section-y) calc(var(--section-y) + 0.5rem);
  }

  .services__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 5vw, 4.5rem);
  }

  .services__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    row-gap: 24px;
    align-items: end;
  }

  .services__title {
    grid-column: span 7;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .services__eyebrow {
    color: var(--color-dark-accent);
  }

  .services__heading {
    font-size: var(--text-display);
    color: var(--color-dark-text);
  }

  .services__lead {
    grid-column: 9 / span 4;
    margin: 0;
    font-size: 17px;
    line-height: var(--line-relaxed);
    color: var(--color-dark-muted);
  }

  /* Approach */
  .approach {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    row-gap: 64px;
  }

  .approach__title {
    grid-column: span 5;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .approach__lead {
    grid-column: 7 / span 6;
    align-self: end;
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .approach__steps {
    grid-column: 1 / -1;
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .approach__step {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 28px;
    border-top: 1px solid var(--color-text);
  }

  .approach__step p {
    margin: 0;
    font-size: var(--text-base);
    line-height: var(--line-relaxed);
    color: var(--color-text-muted);
  }

  .approach__n {
    font-family: var(--font-display);
    font-size: 22px;
    color: var(--color-accent);
  }

  /* Team */
  .team {
    background: var(--color-bg-alt);
  }

  .team__inner {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  .team__head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 48px;
  }

  .team__title {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .team__lead {
    max-width: 420px;
    font-size: 17px;
  }

  .team__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }

  /* Contact */
  .contact {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    row-gap: 48px;
  }

  .contact__intro {
    grid-column: span 6;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .contact__heading {
    font-size: clamp(3rem, 5.2vw, 4.5rem);
    line-height: 1;
  }

  .contact__cards {
    grid-column: 8 / span 5;
    align-self: end;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .contact__card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 28px 32px;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    transition: transform 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
  }

  .contact__card:hover {
    color: var(--color-text);
    transform: translateY(-2px);
    box-shadow: 0 16px 32px -24px rgba(12, 44, 85, 0.45);
  }

  .contact__card--dark {
    background: var(--color-dark);
    border-color: var(--color-dark);
    color: var(--color-dark-text);
  }

  .contact__card--dark:hover {
    color: var(--color-dark-text);
  }

  .contact__card-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .contact__card-label {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .contact__card--dark .contact__card-label {
    color: var(--color-dark-accent);
  }

  .contact__card-email {
    font-size: clamp(1.0625rem, 1.8vw, 1.375rem);
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  :global(.contact__card-icon) {
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .contact__card:hover :global(.contact__card-icon) {
    transform: translate(2px, -2px);
  }

  .contact__address {
    font-style: normal;
    padding: 12px 4px 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-soft);
  }

  /* Responsive */
  @media (max-width: 1080px) {
    .hero__main,
    .facts,
    .services__title,
    .services__lead,
    .approach__title,
    .approach__lead,
    .contact__intro,
    .contact__cards {
      grid-column: 1 / -1;
    }

    .facts {
      max-width: 420px;
    }

    .services__lead,
    .approach__lead {
      max-width: 640px;
    }

    .approach {
      row-gap: 32px;
    }

    .approach__steps {
      margin-top: 24px;
    }

    .contact__cards {
      max-width: 560px;
    }

    .team__grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 760px;
    }
  }

  @media (max-width: 760px) {
    .approach__steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .team__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    .team__inner {
      gap: 40px;
    }

    .contact__card {
      padding: 22px 24px;
    }
  }
</style>
